<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: keep all app data (IndexedDB holding guest and payment records) out of
  Google cloud backup and device-to-device transfer. The only copy outside the app is
  a JSON file the user exports manually from Settings > Export Backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
