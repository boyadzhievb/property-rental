{
  "permissions": {
    "deny": [
      "Read(android/keystore.properties)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Bash(cat android/keystore.properties*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ],
    "ask": [
      "Bash(git push*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-commit-check.sh",
            "timeout": 180,
            "statusMessage": "Pre-commit checks (typecheck + tests)..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-tests.sh",
            "timeout": 60,
            "statusMessage": "Running related unit tests..."
          }
        ]
      }
    ]
  }
}
