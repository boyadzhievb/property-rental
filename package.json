    "@vitest/coverage-v8": "^5.0.5",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.73.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
