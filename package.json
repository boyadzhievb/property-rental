    "@capacitor/local-notifications": "^8.3.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
